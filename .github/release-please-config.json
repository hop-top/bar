{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "separate-pull-requests": true,
  "pull-request-title-pattern": "chore(release): ${component} ${version}",
  "component-no-space": true,
  "include-component-in-tag": false,
  "label": "status:release-pending",
  "release-label": "status:release-tagged",
  "changelog-sections": [
    {
      "type": "feat",
      "section": "Features"
    },
    {
      "type": "fix",
      "section": "Bug Fixes"
    },
    {
      "type": "perf",
      "section": "Performance"
    },
    {
      "type": "refactor",
      "section": "Refactored",
      "hidden": true
    },
    {
      "type": "chore",
      "section": "Miscellaneous",
      "hidden": true
    },
    {
      "type": "docs",
      "section": "Documentation",
      "hidden": true
    },
    {
      "type": "test",
      "section": "Tests",
      "hidden": true
    },
    {
      "type": "ci",
      "section": "CI",
      "hidden": true
    },
    {
      "type": "build",
      "section": "Build",
      "hidden": true
    }
  ],
  "plugins": [
    {
      "type": "target-context",
      "stableBranches": [
        "main"
      ],
      "prereleaseBranches": [
        "next"
      ]
    }
  ],
  "packages": {
    ".": {
      "release-type": "rust",
      "component": "bar",
      "changelog-path": "CHANGELOG.md",
      "bump-minor-pre-major": true,
      "prerelease": true,
      "prerelease-type": "alpha.0",
      "versioning": "target",
      "x-channel": {
        "line": "0.1.0",
        "channel": "rc"
      },
      "extra-files": [
        {
          "type": "json",
          "path": "claude-plugin/.claude-plugin/plugin.json",
          "jsonpath": "$.version"
        },
        {
          "type": "generic",
          "path": "docs/comparison.md"
        }
      ]
    }
  }
}
