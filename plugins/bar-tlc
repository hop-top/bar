#!/bin/sh
# bar-tlc: closed/total tasks of the track of the latest-updated claimed task,
# else of all tasks (scope=track, the default); scope=all counts the whole
# project. Option status filters the counted set. Needs sh, jq and tlc. No
# project in scope, or no tasks, emits empty text (segment hidden). Any failed
# tlc call emits nothing, so a different kind of count never replaces the
# cached value.
if [ "$1" = "--ext-info" ]; then
  printf '%s\n' '{"name":"tlc","version":"0.1.0","description":"Closed tasks of the current track","capabilities":["discover","placeholder"],"options":{"scope":{"type":"enum","enum":["track","all"],"default":"track"},"status":{"type":"string"}},"ttl":"60s"}'
  exit 0
fi

command -v jq >/dev/null 2>&1 && command -v tlc >/dev/null 2>&1 || exit 1

input=$(cat)
cwd=$(printf '%s' "$input" | jq -r '.session.cwd // empty' 2>/dev/null)
scope=$(printf '%s' "$input" | jq -r '.options.scope // "track"' 2>/dev/null) || exit 1
status=$(printf '%s' "$input" | jq -r '.options.status // empty' 2>/dev/null) || exit 1
scope=${scope:-track}
case $scope in track|all) ;; *) exit 1 ;; esac
case $status in -*|*[!A-Za-z0-9_,-]*) exit 1 ;; esac
case $cwd in /*) [ -d "$cwd" ] || cwd=$PWD ;; *) cwd=$PWD ;; esac
case $cwd in /*) ;; *) exit 1 ;; esac

# tlc creates an empty .tlc wherever it runs, so run it at the project root,
# found by its config file; a stray empty .tlc does not count. The search
# stops after the git work-tree root (a dir holding .git; a linked worktree
# also reaches its repo root), so an enclosing project never leaks in; outside a repo only cwd is checked. No project
# hides the segment.
none='{"text":""}'
# b: git boundary (first dir with .git). A linked worktree's .git file maps
# to its repo root r (bare repo dir, else the main worktree), where the
# search continues, never above.
b=
d=$cwd
while :; do
  [ ! -e "$d/.git" ] || { b=$d; break; }
  [ "$d" != / ] || break
  d=$(dirname -- "$d")
done
r=
if [ -n "$b" ] && [ -f "$b/.git" ]; then
  gd=$(sed -n 's/^gitdir: *//p' "$b/.git" 2>/dev/null | head -n 1)
  case $gd in /*) ;; *) gd=$b/$gd ;; esac
  common=
  if [ -f "$gd/commondir" ]; then
    rel=$(head -n 1 "$gd/commondir")
    case $rel in /*) common=$rel ;; *) common=$gd/$rel ;; esac
  else
    case $gd in */worktrees/*) common=${gd%/worktrees/*} ;; esac
  fi
  if [ -n "$common" ] && [ -d "$common" ]; then
    common=$(cd -- "$common" 2>/dev/null && pwd -P) || common=
  fi
  if [ -n "$common" ]; then
    case $common in
      */.git) r=$(dirname -- "$common") ;;
      *) r=$common ;;
    esac
  fi
fi
root=$cwd
while [ ! -f "$root/.tlc/config.yaml" ]; do
  if [ -z "$b" ] || [ "$root" = "$b" ] || [ "$root" = / ]; then
    # past the worktree: also try the repo root, once
    if [ -n "$r" ] && [ -f "$r/.tlc/config.yaml" ]; then root=$r; break; fi
    printf '%s\n' "$none"
    exit 0
  fi
  root=$(dirname -- "$root")
done
cd -- "$root" || exit 1

# No per-call timeout: the host kills the whole process group after 3 s.
run() { tlc "$@" 2>/dev/null; }

pick=
if [ "$scope" = track ]; then
tracks=$(run track list --status active --format json) || exit 1
claimed=$(run task list --status IN_PROGRESS --mine --format json) || exit 1

pick=$(jq -rn --argjson tr "${tracks:-[]}" --argjson tk "${claimed:-[]}" '
  def arr: if type == "array" then . else (.tracks // .tasks // .items // .data // []) end;
  ($tr | arr) as $tracks
  | [ ($tk | arr) | sort_by(.updated_at // "") | reverse | .[]
      | (.track_id // .track // empty) | tostring ] as $tids
  | [ $tids[] as $t | $tracks[]
      | select((.id // "") == $t or (.slug // "") == $t) ]
  | first // empty
  | .id // ""' 2>/dev/null) || exit 1
fi

# $status is empty (no filter) or a validated word list, never an option.
if [ -n "$pick" ]; then
  all=$(run task list --track "$pick" --archived --limit 100000 ${status:+--status "$status"} --format json) || exit 1
else
  all=$(run task list --archived --limit 100000 ${status:+--status "$status"} --format json) || exit 1
fi

printf '%s' "$all" | jq -ce '
  (if type == "array" then . else (.tasks // .items // .data // []) end) as $t
  | ($t | length) as $n
  | if $n == 0 then {text: ""} else
    ([$t[] | select(.status != "TODO" and .status != "IN_PROGRESS")] | length) as $c
  | {text: "\($c)∕\($n)", score: ($c * 100 / $n | floor)} end' 2>/dev/null || exit 1
