#!/bin/sh
# bar-health: HEAD request to option url (http or https only); ✓ for a status
# below 400, ✗ otherwise. Option label is shown dim before the mark. The URL
# goes to curl on stdin, never in arguments. Bad or missing url: exit 1, no
# output. Needs sh, jq and curl.
if [ "$1" = "--ext-info" ]; then
  printf '%s\n' '{"name":"health","version":"0.1.0","description":"HTTP health of a URL","capabilities":["discover","placeholder"],"options":{"url":{"type":"string"},"label":{"type":"string"}},"ttl":"30s"}'
  exit 0
fi

command -v jq >/dev/null 2>&1 && command -v curl >/dev/null 2>&1 || exit 1

input=$(cat)
url=$(printf '%s' "$input" | jq -r '.options.url // empty' 2>/dev/null) || exit 1
label=$(printf '%s' "$input" | jq -r '.options.label // empty' 2>/dev/null) || exit 1

# Single line, http(s) only, no userinfo (it may hold a secret), nothing that
# could break out of the quoted curl config value.
nl='
'
case $url in
  http://*|https://*) ;;
  *) exit 1 ;;
esac
case $url in
  *"$nl"*|*[[:space:][:cntrl:]\"\\]*) exit 1 ;;
esac
hostpart=${url#*://}
hostpart=${hostpart%%[/?#]*}
case $hostpart in ''|*@*) exit 1 ;; esac

code=$(printf 'url = "%s"\n' "$url" | curl -sS -I -o /dev/null --max-time 2 --proto '=http,https' -w '%{http_code}' -K - 2>/dev/null)
rc=$?
up=0
if [ "$rc" -eq 0 ]; then
  case $code in [123][0-9][0-9]) up=1 ;; esac
fi

jq -cn --arg lbl "$label" --arg url "$url" --argjson up "$up" '
  def clean: gsub("\u001b\\][^\u0007\u001b]*(\u0007|\u001b\\\\)?"; "") | gsub("\u001b\\[[0-9;:?<=>]*[ -/]*[@-~]"; "") | gsub("[\u0001-\u001f\u007f-\u009f\u2028\u2029\u202a-\u202e\u2066-\u2069]"; "");
  {text: (if $up == 1 then "✓" else "✗" end),
   style: (if $up == 1 then "good" else "bad" end),
   link: $url}
  + (($lbl | clean) as $l | if $l != "" then {label: $l} else {} end)' 2>/dev/null || exit 1
