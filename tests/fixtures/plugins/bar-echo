#!/bin/sh
# Test plugin. Control files beside the script: out.json (stdout body),
# exit (exit code). Logs every --ext-info call to info.log and saves the
# render input to stdin.json.
here=$(dirname "$0")
if [ "$1" = "--ext-info" ]; then
  echo x >> "$here/info.log"
  cat <<'JSON'
{"name":"echo","version":"1.0.0","description":"test plugin",
 "capabilities":["discover","placeholder"],
 "options":{
   "limit":{"type":"int","default":3},
   "mode":{"type":"enum","enum":["a","b"]},
   "verbose":{"type":"bool"},
   "label":{"type":"string"}}}
JSON
  exit 0
fi
cat > "$here/stdin.json"
if [ -f "$here/out.json" ]; then cat "$here/out.json"; else echo '{"text":"ok"}'; fi
[ -f "$here/exit" ] && exit "$(cat "$here/exit")"
exit 0
