#!/usr/bin/env python3
"""Stage the npm packages of a release from its archives.

    scripts/npm-stage VERSION ASSETS OUT

VERSION   the release version, no leading `v` (the tag without it)
ASSETS    directory holding bar-VERSION-<target>.tar.gz / .zip and their
          .sha256 files, as the release workflow uploads them
OUT       directory to write; gets one ready-to-publish directory per
          package: the platform packages, then `bar` (the launcher)

Copies packaging/npm/, checks that every package.json (and each of the
launcher's optionalDependencies) carries VERSION and that the launcher
lists exactly the platform packages, verifies each archive against its
.sha256, unpacks its binaries (bar, bar-cliproxyapi) into the platform package's bin/ and adds
LICENSE to every package. Prints the package directories, platform
packages first, in publish order.
"""

import hashlib
import json
import shutil
import sys
import tarfile
import zipfile
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
NPM = ROOT / "packaging" / "npm"
LAUNCHER = "bar"
# executables each archive holds; bar finds the plugin in its own directory
BINARIES = ("bar", "bar-cliproxyapi")

# platform package directory -> release target
TARGETS = {
    "bar-darwin-arm64": "aarch64-apple-darwin",
    "bar-darwin-x64": "x86_64-apple-darwin",
    "bar-linux-arm64": "aarch64-unknown-linux-musl",
    "bar-linux-x64": "x86_64-unknown-linux-musl",
    "bar-win32-arm64": "aarch64-pc-windows-msvc",
    "bar-win32-x64": "x86_64-pc-windows-msvc",
}


def die(msg):
    sys.exit(f"npm-stage: {msg}")


def manifest(d):
    return json.loads((d / "package.json").read_text())


def check_versions(version):
    dirs = sorted(p.name for p in NPM.iterdir() if (p / "package.json").is_file())
    if sorted([LAUNCHER, *TARGETS]) != dirs:
        die(f"packaging/npm has {dirs}, expected {sorted([LAUNCHER, *TARGETS])}")
    names = {}
    for d in dirs:
        m = manifest(NPM / d)
        if m.get("version") != version:
            die(f"packaging/npm/{d}/package.json: version {m.get('version')!r}, release is {version!r}")
        names[d] = m["name"]
    deps = manifest(NPM / LAUNCHER).get("optionalDependencies", {})
    want = {names[d] for d in TARGETS}
    if set(deps) != want:
        die(f"launcher optionalDependencies {sorted(deps)}, expected {sorted(want)}")
    for name, v in deps.items():
        if v != version:
            die(f"launcher optionalDependencies {name}: {v!r}, release is {version!r}")


def verify(asset):
    sums = asset.with_name(asset.name + ".sha256")
    if not sums.is_file():
        die(f"missing {sums.name}")
    want = sums.read_text().split()[0].lower()
    got = hashlib.sha256(asset.read_bytes()).hexdigest()
    if got != want:
        die(f"{asset.name}: sha256 {got}, {sums.name} says {want}")


def unpack(asset, exe, dest):
    dest.mkdir(parents=True, exist_ok=True)
    out = dest / exe
    if asset.suffix == ".zip":
        with zipfile.ZipFile(asset) as z:
            if exe not in z.namelist():
                die(f"{asset.name}: no {exe}")
            out.write_bytes(z.read(exe))
    else:
        with tarfile.open(asset) as t:
            try:
                member = t.getmember(exe)
            except KeyError:
                die(f"{asset.name}: no {exe}")
            if not member.isfile():
                die(f"{asset.name}: {exe} is not a regular file")
            out.write_bytes(t.extractfile(member).read())
    out.chmod(0o755)


def main(argv):
    if len(argv) != 3:
        die("usage: scripts/npm-stage VERSION ASSETS OUT")
    version, assets, out = argv[0], Path(argv[1]), Path(argv[2])
    if version.startswith("v"):
        die(f"version {version!r}: drop the leading v")
    check_versions(version)
    if out.exists() and any(out.iterdir()):
        die(f"{out} is not empty")
    licence = ROOT / "LICENSE"
    order = [*TARGETS, LAUNCHER]
    for d in order:
        dest = out / d
        shutil.copytree(NPM / d, dest)
        shutil.copy2(licence, dest / "LICENSE")
    for d, target in TARGETS.items():
        windows = "-windows-" in target
        asset = assets / f"bar-{version}-{target}.{'zip' if windows else 'tar.gz'}"
        if not asset.is_file():
            die(f"missing {asset.name} in {assets}")
        verify(asset)
        for exe in BINARIES:
            unpack(asset, exe + (".exe" if windows else ""), out / d / "bin")
    for d in order:
        print(out / d)


if __name__ == "__main__":
    main(sys.argv[1:])
