#!/usr/bin/env python3
"""Builds docs/gallery.md and docs/gallery/*.svg from real `bar` output.

Every image is the ANSI output of `bar preview` (or `bar render` with a
seeded sample history, for sparklines) for one config, drawn as an SVG with
each character converted to a path from the font, so viewers need no font.

    scripts/gallery            regenerate page, images and MANIFEST
    scripts/gallery --check    exit 1 when the committed files are stale

Font: Hack Nerd Font Mono (Regular and Bold), from ~/Library/Fonts,
/Library/Fonts, ~/.local/share/fonts or /usr/share/fonts, or the directory
in GALLERY_FONT_DIR. Drawing needs fontTools (vetted in
docs/dependencies.md); --check does not: it reruns bar, compares the output
hashes with docs/gallery/MANIFEST, and checks that page and images match the
hashes recorded there.
"""

import hashlib
import json
import os
import subprocess
import sys
import tempfile
import time
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
OUT = ROOT / "docs" / "gallery"
PAGE = ROOT / "docs" / "gallery.md"
MANIFEST = OUT / "MANIFEST"
FONT_FILES = {
    False: "HackNerdFontMono-Regular.ttf",
    True: "HackNerdFontMono-Bold.ttf",
}

# --- samples --------------------------------------------------------------

MID = (
    'set left "#{model}#{effort} │ #{ctx} │ #{repo}:#{branch}"\n'
    'set center "#{usage[type=5h]} │ #{usage[type=7d]}"\n'
    'set right "#{account}"\n'
)
GIT = (
    'set left "#{model}#{effort} │ #{ctx} │ #{repo}:#{branch} #{dirty} │ #{prs[limit=3]}"\n'
    'set right "#{usage[type=5h]} │ #{usage[type=7d]}"\n'
)


def usage_pair(opts):
    return (
        f'set left "#{{usage[type=5h,{opts}]}} │ #{{usage[type=7d,{opts}]}}"\n'
    )


def sample(name, alt, conf, state="early", columns=100, history=False):
    return {
        "name": name,
        "alt": alt,
        "conf": conf,
        "state": state,
        "columns": columns,
        "history": history,
    }


SECTIONS = []


def section(title, intro, samples):
    SECTIONS.append({"title": title, "intro": intro, "samples": samples})


section(
    "Skins",
    "`set skin` picks how segments are drawn. Powerline and capsule glyphs "
    "need a Nerd Font in the terminal. See [Skins](config.md#skins).",
    [
        sample(
            "skin-plain",
            "Plain skin, default palette: segments split by muted bars.",
            "set palette default\nset icons nerdfont\n" + MID,
        ),
        sample(
            "skin-powerline",
            "Powerline skin, nord palette: segments on coloured backgrounds "
            "joined by arrows.",
            "set skin powerline\nset palette nord\nset icons nerdfont\n" + MID,
        ),
        sample(
            "skin-capsule",
            "Capsule skin, dracula palette: each segment in a rounded pill.",
            "set skin capsule\nset palette dracula\nset icons nerdfont\n" + MID,
        ),
    ],
)

PALETTES = ["default", "nord", "gruvbox", "dracula", "solarized", "mono", "terminal"]
section(
    "Palettes",
    "`set palette` swaps muted text, state colours, the usage ramp and the "
    "skin backgrounds; here on the powerline skin in the `burning` state. "
    "`terminal` uses the terminal's own 16 colours, drawn here with the "
    "xterm defaults. See [Palettes](config.md#palettes).",
    [
        sample(
            f"palette-{p}",
            f"Powerline skin with the {p} palette.",
            f"set skin powerline\nset palette {p}\nset icons nerdfont\n" + MID,
            state="burning",
        )
        for p in PALETTES
    ],
)

GLYPHS = [
    ("blocks", "default"),
    ("shades", "nord"),
    ("dots", "gruvbox"),
    ("squares", "dracula"),
    ("bars", "solarized"),
    ("braille", "terminal"),
    ("eighths", "mono"),
]
section(
    "Bar glyphs",
    "`glyphs=` on `usage` picks the cells of the bar; 10 cells wide here, "
    "`burning` state (25% and 30% left), so `eighths` shows its partial "
    "last cell.",
    [
        sample(
            f"glyphs-{g}",
            f"Usage bars drawn with the {g} glyph set, {p} palette.",
            f"set palette {p}\n" + usage_pair(f"glyphs={g},width=10"),
            state="burning",
            columns=60,
        )
        for g, p in GLYPHS
    ],
)

section(
    "Solid and gradient bars",
    "`color=solid` (default) paints every filled cell in the colour of the "
    "current value; `color=gradient` runs the filled cells along the ramp. "
    "Both on the default palette, whose ramp has eleven steps.",
    [
        sample(
            f"color-{c}",
            f"10-cell usage bars with color={c}, default palette, burning state.",
            "set palette default\n" + usage_pair(f"color={c},width=10,show=bar,pct"),
            state="burning",
            columns=60,
        )
        for c in ["solid", "gradient"]
    ],
)

section(
    "Spark and gauge",
    "`spark` draws the used percent of the last samples, `gauge` one cell "
    "for the current value. `bar preview` keeps no history, so these come "
    "from `bar render` with a sample session (5-hour window 90% used, "
    "weekly 60%) and five seeded history samples per window "
    "(15, 35, 55, 75, 90 and 10, 20, 30, 45, 60 percent used).",
    [
        sample(
            "spark-gauge",
            "5-hour and weekly usage as time, sparkline, gauge cell and "
