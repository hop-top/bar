        sample(
            "spark-gradient",
            "Sparklines with color=gradient, each cell coloured by its own "
            "value, default palette.",
            "set palette default\n"
            + usage_pair("show=spark,bar,color=gradient,width=8"),
            columns=60,
            history=True,
        ),
    ],
)

STATES = [
    ("early", "plenty of budget left; bars green"),
    ("burning", "spending fast; bars orange to yellow"),
    ("final", "last stretch with budget left over; red means budget going unused"),
]
section(
    "Pace states",
    "`bar preview --state` picks the sample usage; the colour follows the "
    "pace score, flipped in the final stretch.",
    [
