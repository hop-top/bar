)

section(
    "Lines",
    "`set left@2` and friends add lines, up to 4. The `two-line` preset puts "
    "session and git on line 1 and usage below. See "
    "[Lines and wrapping](config.md#lines-and-wrapping).",
    [
        sample(
            "two-line",
